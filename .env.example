# ═══════════════════════════════════════════
# PlanVocate Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GUIDE_PRICE_ID=price_...
STRIPE_GUIDE_PRICE_DISPLAY=10.00

# Admin
ADMIN_PASSWORD=strong-unique-password-here

# Email notifications: NOT configured at launch.
# Reviews and feedback are visible in the admin panel at /admin.
# To add email notifications later: add Resend or SendGrid, set FROM_EMAIL,
# ADMIN_EMAIL, and SUPPORT_EMAIL env vars, and uncomment the notify functions.
# No other code changes required — notification calls are stubbed in the functions.
