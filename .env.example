# ═══════════════════════════════════════════
# EduAdvocate Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000

# JWT Authentication
JWT_SECRET=your-strong-random-secret-minimum-32-characters
JWT_EXPIRES_IN=30d

# Email (SendGrid SMTP)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=hello@eduadvocate.com
ADMIN_EMAIL=your-admin-email-for-feedback-notifications

# Stripe (inactive at launch — activate when payments go live)
# STRIPE_ACTIVATE: Uncomment all variables below when enabling payments
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PARENT_PRICE_ID=price_...
# STRIPE_EDUCATOR_PRICE_ID=price_...

# Frontend URL (used for CORS, password reset links, etc.)
APP_URL=https://eduadvocate.com
